{
  "name": "when-dungeons-arise-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Lembretes - Guilda de Aventureiros (versão desktop)",
  "author": "When Dungeons Arise",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:win:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.whendungeonsarise.lembretes",
    "productName": "Lembretes - Guilda de Aventureiros",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "dist"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
