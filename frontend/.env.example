# Copie este arquivo pra ".env.local" (ignorado pelo git) e preencha com os
# valores do seu projeto Supabase (Project Settings > API no painel do
# supabase.com). Sem essas variáveis o app funciona 100% normalmente, só sem
# sincronizar entre aparelhos — tudo continua salvo local (localStorage/
# IndexedDB) como sempre foi.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
