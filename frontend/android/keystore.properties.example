# Copie este arquivo pra keystore.properties (fica fora do git) e preencha
# com os valores reais da sua keystore de release. Sem esse arquivo, o
# build de release cai automaticamente pra assinatura de debug (não
# publicável na Play Store, mas não quebra o build local/CI).
storeFile=stellafounds-release.jks
storePassword=
keyAlias=stellafounds
keyPassword=
